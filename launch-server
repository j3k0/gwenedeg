#!/bin/bash

CONFIG="$1"
CONFIG="${CONFIG:-saluki}"
BIND_HOST="$(tailscale ip --4)"

# defaults
NAME=qwen3.8-27b
DRAFT_MODEL=models/Qwen3.5-0.8B-GGUF/Qwen3.5-0.8B-Q4_K_M.gguf
MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q3_K_M.gguf
# MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
KV_CACHE_TYPE=bf16-dot
PARALLEL=1
BIND_PORT=8417
CONTEXT=98304

KV_DISK="./kv-cache"
KV_DISK_MAX="10"

# Saluki on port 8417
if [ "$CONFIG" = "saluki" ]; then
  MODEL=models/Underdog-Saluki-27B-1.0-GGUF/Underdog-Saluki-27B-1.0-IQ2-mix.gguf
  NAME=saluki-27b
  KV_CACHE_TYPE=q8-dot
  PARALLEL=2
  BIND_PORT=8418
fi

# /runq serve $MODEL -c 98304 -k bf16-dot --draft $DRAFT_MODEL --slots 2 --parallel 2 --checkpoints 3 --spec-calibrate 32768 --timeout 0 --port $BIND_PORT --host $BIND_HOST --name qwen3.8-27b

mkdir -p "$KV_DISK"
./runq serve "$MODEL" \
  --ctx "$CONTEXT" \
  -G 5 --tau 0.4 \
  -k "$KV_CACHE_TYPE" \
  --draft "$DRAFT_MODEL" \
  --slots $PARALLEL --parallel $PARALLEL \
  --port "$BIND_PORT" --host "$BIND_HOST" \
  --name "$NAME"

