#!/bin/bash

CONFIG="$1"
BIND_HOST="$(tailscale ip --4)"

# defaults
NAME=qwen3.8-27b
DRAFT_MODEL=models/Qwen3.5-0.8B-GGUF/Qwen3.5-0.8B-Q4_K_M.gguf
MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q3_K_M.gguf
# MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
KV_CACHE_TYPE=q8-dot
PARALLEL=1
BIND_PORT=8417
# CONTEXT=65536
CONTEXT=98304

KV_DISK="./kv-cache"
KV_DISK_MAX="10"

# Saluki on port 8417
if [ "$CONFIG" = "saluki" ]; then
  MODEL=models/Underdog-Saluki-27B-1.0-GGUF/Underdog-Saluki-27B-1.0-IQ2-mix.gguf
  NAME=saluki-27b
  KV_CACHE_TYPE=q8-dot
  PARALLEL=2
  BIND_PORT=8418
elif [ "$CONFIG" = "qwen3.8-27b-q4" ]; then
  MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
  KV_CACHE_TYPE=q8-dot
elif [ "$CONFIG" = "qwen3.8-27b-q3" ]; then
  MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q3_K_M.gguf
  KV_CACHE_TYPE=q8-dot
elif [ "$CONFIG" = "qwopus" ]; then
  # Qwopus3.8-27B-Flash-V2 (Qwen3.8-27B fine-tune): its MTP block is validated but not run yet (TODO S9),
  # so the Qwen3.5-0.8B drafter stays (identical vocabulary)
  MODEL=models/Qwopus3.8-27B-Flash-V2-GGUF/Qwopus3.8-27B-Flash-V2-MTP-Q4_K_M.gguf
  NAME=qwopus3.8-27b
  KV_CACHE_TYPE=q8-dot
elif [ "$CONFIG" = "ista-iq3s" ]; then
  # ISTA-DASLab Qwen3.8-27B GSQ-RCO IQ3_S (3.5 bpw, 11.8 GB), its BF16 ssm_alpha / ssm_beta rewritten as F32
  # (runq takes them as F32 only; lcb_timebox/tools/gguf_bf16_to_f32.py, exact)
  MODEL=models/Qwen3.8-27B-GSQ-RCO-GGUF/Qwen3.8-27B-GSQ-RCO-IQ3_S-f32ssm.gguf
  NAME=qwen3.8-27b-iq3s
  KV_CACHE_TYPE=q8-dot
else
  echo "Usage: $0 <config>"
  echo "Config:"
  echo "- saluki"
  echo "- qwen3.8-27b-q3"
  echo "- qwen3.8-27b-q4"
  echo "- qwopus"
  echo "- ista-iq3s"
  echo "Env: KV=<type> overrides the KV cache type (q8-dot, q4-dot, q4k4-dot, ...); PAR=<n> the parallel requests"
fi

# KV cache override, e.g. KV=q4-dot ./launch-server saluki
KV_CACHE_TYPE="${KV:-$KV_CACHE_TYPE}"
# parallel requests (= slots) override, e.g. PAR=3 ./launch-server saluki
PARALLEL="${PAR:-$PARALLEL}"

# /runq serve $MODEL -c 98304 -k bf16-dot --draft $DRAFT_MODEL --slots 2 --parallel 2 --checkpoints 3 --spec-calibrate 32768 --timeout 0 --port $BIND_PORT --host $BIND_HOST --name qwen3.8-27b

mkdir -p "$KV_DISK"
./runq serve "$MODEL" \
  --ctx "$CONTEXT" \
  --timeout 0 \
  -G 5 --tau 0.4 \
  -k "$KV_CACHE_TYPE" \
  --draft "$DRAFT_MODEL" \
  --slots $PARALLEL --parallel $PARALLEL \
  --kv-disk "$KV_DISK" --kv-disk-max "$KV_DISK_MAX" \
  --port "$BIND_PORT" --host "$BIND_HOST" \
  --name "$NAME"

