#!/bin/bash

CONFIG="$1"
BIND_HOST="$(tailscale ip --4)"

# defaults
NAME=qwen3.8-27b
DRAFT_MODEL=models/Qwen3.5-0.8B-GGUF/Qwen3.5-0.8B-Q4_K_M.gguf
MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q3_K_M.gguf
# MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
KV_CACHE_TYPE=q8-dot
PARALLEL=4   # requests running at once (batched); bound admission makes the ones that do not fit wait
ADMIT=bound  # bound: admitted on prompt + max_tokens (docs/memory-admission.md); worst: every slot reserved at --ctx
BIND_PORT=8417
# CONTEXT=65536
CONTEXT=98304

KV_DISK="./kv-cache"
KV_DISK_MAX="10"

# Saluki on port 8418
if [ "$CONFIG" = "saluki" ]; then
  MODEL=models/Underdog-Saluki-27B-1.0-GGUF/Underdog-Saluki-27B-1.0-IQ2-mix.gguf
  NAME=saluki-27b
  KV_CACHE_TYPE=q8-dot
  BIND_PORT=8418
elif [ "$CONFIG" = "qwen3.8-27b-q4" ]; then
  MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
  KV_CACHE_TYPE=q8-dot
elif [ "$CONFIG" = "qwen3.8-27b-q3" ]; then
  MODEL=models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q3_K_M.gguf
  KV_CACHE_TYPE=q8-dot
elif [ "$CONFIG" = "qwopus" ]; then
  # Qwopus3.8-27B-Flash-V2 (Qwen3.8-27B fine-tune): its MTP block is validated but not run yet (TODO S9),
  # so the Qwen3.5-0.8B drafter stays (identical vocabulary)
  MODEL=models/Qwopus3.8-27B-Flash-V2-GGUF/Qwopus3.8-27B-Flash-V2-MTP-Q4_K_M.gguf
  NAME=qwopus3.8-27b
  KV_CACHE_TYPE=q8-dot
elif [ "$CONFIG" = "ista-iq3s" ]; then
  # ISTA-DASLab Qwen3.8-27B GSQ-RCO IQ3_S (3.5 bpw, 12.1 GB), the file with its MTP block (blk.64, Q6_K): BF16
  # ssm_alpha / ssm_beta widened to F32 at load (TODO S9.1; logits identical to the F32-rewritten file's); the block
  # is not loaded unless --draft mtp (TODO S9c)
  MODEL=models/Qwen3.8-27B-GSQ-RCO-GGUF/Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf
  NAME=qwen3.8-27b-iq3s
  KV_CACHE_TYPE=q8-dot
else
  echo "Usage: $0 <config>"
  echo "Config:"
  echo "- saluki"
  echo "- qwen3.8-27b-q3"
  echo "- qwen3.8-27b-q4"
  echo "- qwopus"
  echo "- ista-iq3s"
  echo "Env: KV=<type> overrides the KV cache type (q8-dot, q4-dot, q4k4-dot, ...); PAR=<n> the parallel requests; ADMIT_MODE=worst|bound|chunk the admission"
  exit 2
fi

# KV cache override, e.g. KV=q4-dot ./launch-server saluki
KV_CACHE_TYPE="${KV:-$KV_CACHE_TYPE}"
# parallel requests override, e.g. PAR=3 ./launch-server saluki
PARALLEL="${PAR:-$PARALLEL}"
# admission override, e.g. ADMIT_MODE=worst PAR=2 ./launch-server saluki (the pool before memory-aware admission)
ADMIT="${ADMIT_MODE:-$ADMIT}"
# slots: bound / chunk keep 2 idle ones as prefix caches (reclaimed when memory is needed); worst sizes every slot
if [ "$ADMIT" = worst ]; then SLOTS=$PARALLEL; else SLOTS=$((PARALLEL + 2)); fi

# /runq serve $MODEL -c 98304 -k bf16-dot --draft $DRAFT_MODEL --slots 2 --parallel 2 --checkpoints 3 --spec-calibrate 32768 --timeout 0 --port $BIND_PORT --host $BIND_HOST --name qwen3.8-27b

mkdir -p "$KV_DISK"
./runq serve "$MODEL" \
  --ctx "$CONTEXT" \
  --timeout 0 \
  -G 5 --tau 0.4 \
  -k "$KV_CACHE_TYPE" \
  --draft "$DRAFT_MODEL" \
  --slots $SLOTS --parallel $PARALLEL --admit "$ADMIT" \
  --kv-disk "$KV_DISK" --kv-disk-max "$KV_DISK_MAX" \
  --port "$BIND_PORT" --host "$BIND_HOST" \
  --name "$NAME"

